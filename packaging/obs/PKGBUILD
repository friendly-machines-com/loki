pkgname=loki
pkgver=0.1.0
pkgrel=1
pkgdesc="Really really minimal-dependency coding agent"
arch=('any')
url="https://friendly-machines.com/git/loki.git"
license=('MIT')
# Arch Extra supplies a supported PyPy. Derivatives without it can build with
# LOKI_PYTHON=python; this is a package-build choice, never a runtime fallback.
_loki_python=${LOKI_PYTHON:-pypy3}
case "$_loki_python" in
  pypy3) depends=('pypy3>=8.0.1') ;;
  python) depends=('python>=3.11.10') ;;
  *) printf 'LOKI_PYTHON must be pypy3 or python\n' >&2; return 1 ;;
esac
makedepends=('python-build' 'python-flit-core' 'python-installer' 'python-packaging' 'python-wheel')
source=("$pkgname-$pkgver.tar.gz" 'install-wheels.py')
# OBS produces this archive from the Git revision selected in _service.
# set_version resets this assignment to one SKIP; append the local helper's
# checksum separately so its rewrite preserves one checksum per source.
sha256sums=('SKIP')
sha256sums+=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname-$pkgver"
  python "$srcdir/install-wheels.py" --python="/usr/bin/$_loki_python" \
    --destdir="$pkgdir" dist/*.whl
  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
