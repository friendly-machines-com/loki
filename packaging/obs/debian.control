Source: loki
Section: devel
Priority: optional
Maintainer: Danny Milosavljevic <dannym@friendly-machines.com>
Build-Depends: debhelper-compat (= 13),
               dh-python,
               pybuild-plugin-pyproject,
               python3-all (>= 3.11.10),
               python3-flit-core (>= 3.8),
               pypy3 (>= 7.3.19) <!cpython>
Standards-Version: 4.7.0
Homepage: https://friendly-machines.com/git/loki.git
Rules-Requires-Root: no

Package: loki
Architecture: all
Depends: ${misc:Depends}, ${python3:Depends}, ${loki:Runtime},
         python3 (>= 3.11.10),
         python3 (<< 3.12) | python3 (>= 3.12.4)
Description: Really really minimal-dependency coding agent
 No-nonsense coding agent with minimal dependencies.
