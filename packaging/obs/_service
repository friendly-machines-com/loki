<services>
  <service name="obs_scm">
    <param name="url">https://friendly-machines.com/git/loki.git</param>
    <param name="scm">git</param>
    <param name="revision">master</param>
    <param name="filename">loki</param>
    <!-- Keep the archive version aligned with loki_agent/__init__.py and the
         package recipes. Change this when packaging a new upstream version. -->
    <param name="versionformat">0.1.0</param>
  </service>
  <!-- Generate portable sources on the OBS server: service RPMs are not
       available in every target distribution's build repositories. -->
  <service name="tar" mode="serveronly"/>
  <service name="recompress" mode="serveronly">
    <param name="file">*.tar</param>
    <param name="compression">gz</param>
  </service>
  <service name="set_version" mode="serveronly"/>
</services>
